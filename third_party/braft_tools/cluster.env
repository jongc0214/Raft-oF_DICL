# --- 원본 cluster.env (그대로 유지) ------------------------------------------
PORT=8200
# 원본: CONF="115.145.173.123:8200:0,115.145.173.124:8200:0,115.145.173.125:8200:0"
#   -> 정적 문자열 대신 아래 NODES/POOL 로 build_conf 가 같은 형식으로 생성한다.
BLOCK_BUILD_DIR="${BLOCK_BUILD_DIR:-/home/jongc/braft/example/block/build}"

# --- 추가: 노드 풀 + 실행 시 선택 ---------------------------------------------
# 노드 풀은 아래 POOL (고정). 이번 실행에 쓸 노드는 NODES / TOPO 로 고른다:
#   ./run_block_node.sh 4                    # 기본: TOPO=3 -> NODES="4 5 6"
#   TOPO=5 ./run_block_node.sh 4             # 5노드 프리셋 ("2 3 4 5 6"), TOPO=7/9 도 있음
#   NODES="1 4 5 6" ./run_block_node.sh 4    # 직접 지정
#
# !! 모든 서버/클라이언트가 같은 NODES 를 써야 한다 (-conf 의 멤버 수 = quorum 기준).
# !! braft 는 데이터 디렉터리에 이미 저장된 구성이 있으면 -conf 보다 그것을 따른다
#    (일반적인 braft 동작; 이 환경에서 확인하지는 않음). 구성을 바꿀 때는
#    모든 노드를 clean_block_node.sh 로 비우고 다시 띄운다.

# 풀 형식: id|ip   (Ethernet 주소, eternityN = id N. 출처: 사용자 제공 인벤토리)
POOL=(
  "1|115.145.173.242"
  "2|115.145.173.244"
  "3|115.145.173.245"
  "4|115.145.173.123"
  "5|115.145.173.124"
  "6|115.145.173.125"
  "7|115.145.173.126"    # 빌린 노드 (raftof_clean/borrow_node.sh up 후 사용)
  "8|115.145.173.127"    # 빌린 노드
  "9|115.145.173.128"    # 빌린 노드
  "10|115.145.173.129"   # 빌린 노드
)

# 프리셋은 raftof_clean/env.sh 와 같게 맞춘다 (같은 TOPO 로 두 시스템을 비교한다).
TOPO_3_NODES="${TOPO_3_NODES:-4 5 6}"
TOPO_4_NODES="${TOPO_4_NODES:-3 4 5 6}"
TOPO_5_NODES="${TOPO_5_NODES:-2 3 4 5 6}"
TOPO_6_NODES="${TOPO_6_NODES:-1 2 3 4 5 6}"
TOPO_7_NODES="${TOPO_7_NODES:-2 3 4 5 6 7 8}"
TOPO_9_NODES="${TOPO_9_NODES:-2 3 4 5 6 7 8 9 10}"

if [[ -z "${NODES:-}" ]]; then
  case "${TOPO:-3}" in
    3) NODES="$TOPO_3_NODES" ;;
    4) NODES="$TOPO_4_NODES" ;;
    5) NODES="$TOPO_5_NODES" ;;
    6) NODES="$TOPO_6_NODES" ;;
    7) NODES="$TOPO_7_NODES" ;;
    9) NODES="$TOPO_9_NODES" ;;
    *) echo "invalid TOPO: ${TOPO} (3|4|5|6|7|9)" >&2; return 1 2>/dev/null || exit 1 ;;
  esac
fi
export NODES

is_valid_id() {
  local x
  for x in $NODES; do
    [[ "$x" == "$1" ]] && return 0
  done
  return 1
}

valid_ids_pipe() { echo "${NODES// /|}"; }

# ip_for_id <id>
ip_for_id() {
  local e id ip
  for e in "${POOL[@]}"; do
    e="${e%%#*}"
    id="${e%%|*}"; ip="${e#*|}"; ip="${ip//[[:space:]]/}"
    if [[ "$id" == "$1" ]]; then
      if [[ "$ip" == TODO* ]]; then
        echo "node $1: cluster.env POOL 의 TODO 값을 채우기 전에는 쓸 수 없다" >&2
        return 1
      fi
      echo "$ip"; return 0
    fi
  done
  echo "node $1: POOL 에 없음" >&2
  return 1
}

# build_conf -> CONF="ip:port:0,ip:port:0,..."  (NODES 순서)
build_conf() {
  local id ip
  CONF=""
  for id in $NODES; do
    ip="$(ip_for_id "$id")" || return 1
    CONF+="${CONF:+,}${ip}:${PORT}:0"
  done
  export CONF
}

# 하위 호환: 원본 cluster.env 는 source 하면 CONF 가 바로 정의됐다.
build_conf 2>/dev/null || CONF=""